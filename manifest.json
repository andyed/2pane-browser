{
  "manifest_version": 3,
  "name": "2Pane Split Screen",
  "version": "1.0",
  "description": "Splits the current tab into a two-pane view, simulating a tall monitor.",
  "permissions": ["activeTab", "scripting", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "Toggle 2Pane"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["iframe_script.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
